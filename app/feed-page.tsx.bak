import Link from 'next/link'
import { getAllArticles, getAllCourses, getAllTags } from '@/lib/content'
import { ArticleCard } from '@/components/content/ArticleCard'
import { RotatingQuote } from '@/components/ui/RotatingQuote'

export default function HomePage() {
  const articles = getAllArticles()
  const courses = getAllCourses()
  const tags = getAllTags()

  return (
    <div className="animate-fade-in">
      {/* Editorial Header */}
      <section className="pt-16 pb-10 sm:pt-24 sm:pb-12 lg:pt-32 lg:pb-14">
        <div className="max-w-3xl mx-auto px-4 sm:px-6 text-center">
          <h1 className="font-heading text-3xl sm:text-4xl lg:text-5xl text-text-primary uppercase tracking-[0.08em]">
            Contemplative CrossFit
          </h1>
          <p className="text-text-muted text-xs uppercase tracking-[0.2em] mt-4 font-heading">
            Rigorous mind training for serious practitioners.
          </p>
          <div className="mt-12 sm:mt-16 max-w-xl mx-auto">
            <div className="border-t border-border-subtle pt-8 pb-4 min-h-[80px] flex items-center justify-center">
              <RotatingQuote />
            </div>
          </div>
        </div>
      </section>

      {/* Content Feed */}
      <section className="py-12 sm:py-16 border-t border-border-subtle">
        <div className="max-w-3xl mx-auto px-4 sm:px-6">
          {/* Editorial Topics Bar */}
          <div className="flex flex-wrap items-center gap-x-4 gap-y-2 mb-10">
            <span className="text-sm font-heading uppercase tracking-[0.2em] text-text-muted flex-shrink-0">
              Topics
            </span>
            <span className="text-border-subtle select-none">/</span>
            <div className="flex flex-wrap items-center gap-1">
              {tags.map((tag, i) => (
                <span key={tag} className="flex items-center gap-1">
                  <Link
                    href={`/articles/topics/${encodeURIComponent(tag)}`}
                    className="text-sm font-heading uppercase tracking-[0.15em] text-text-secondary hover:text-accent transition-colors whitespace-nowrap"
                  >
                    {tag}
                  </Link>
                  {i < tags.length - 1 && (
                    <span className="text-border text-xs select-none mx-1">&middot;</span>
                  )}
                </span>
              ))}
            </div>
          </div>

          {articles.length > 0 ? (
            <div>
              {articles.slice(0, 6).map(article => (
                <ArticleCard key={article.slug} article={article} />
              ))}
            </div>
          ) : (
            <p className="font-body text-text-muted py-8">Content coming soon.</p>
          )}

          {articles.length > 6 && (
            <div className="mt-8 text-center">
              <Link href="/articles" className="font-heading text-accent hover:text-accent-hover text-xs uppercase tracking-[0.15em] transition-colors">
                View all articles &rarr;
              </Link>
            </div>
          )}
        </div>
      </section>

      {/* Featured Course */}
      {courses.length > 0 && (
        <section className="py-12 sm:py-16 border-t border-border-subtle">
          <div className="max-w-3xl mx-auto px-4 sm:px-6">
            <div className="p-6 sm:p-10 border border-border rounded-sm bg-bg-secondary/30">
              <span className="text-xs font-heading uppercase tracking-[0.2em] text-accent">Free Course</span>
              <h2 className="font-heading text-xl sm:text-2xl text-text-primary mt-3 uppercase tracking-wide">
                {courses[0].title}
              </h2>
              <p className="font-body text-text-secondary mt-3 leading-relaxed text-sm">
                {courses[0].description}
              </p>
              <Link
                href={`/courses/${courses[0].slug}`}
                className="inline-block mt-6 font-heading text-accent hover:text-accent-hover text-xs uppercase tracking-[0.15em] transition-colors"
              >
                Start learning &rarr;
              </Link>
            </div>
          </div>
        </section>
      )}

      {/* Bootcamp CTA */}
      <section className="py-16 sm:py-24 border-t border-border-subtle">
        <div className="max-w-3xl mx-auto px-4 sm:px-6 text-center">
          <h2 className="font-heading text-xl sm:text-2xl text-text-primary uppercase tracking-wide">
            Ready to train?
          </h2>
          <p className="font-body text-text-secondary mt-4 max-w-lg mx-auto leading-relaxed text-sm">
            For practitioners who&apos;ve exhausted the solo path.
            Stop practising. Start training.
          </p>
          <Link
            href="/bootcamp"
            className="btn-primary mt-8 px-8 py-3"
          >
            Learn about the Bootcamp
          </Link>
        </div>
      </section>
    </div>
  )
}
